<h2 class="mb-3">All Jobs</h2>
<p><%= link_to "Sidekiq Queue", sidekiq_web_path, target: "_blank", class: "text-muted" %></p>
<table class="table table-striped table-bordered mt-3">
  <thead>
    <tr>
      <th><%= link_to "ID", admin_jobs_path(sort: "id", direction: @sort_direction == "asc" && @sort_column == "id" ? "desc" : "asc"), class: "text-decoration-none" %></th>
      <th>User</th>
      <th><%= link_to "Created At", admin_jobs_path(sort: "created_at", direction: @sort_direction == "asc" && @sort_column == "created_at" ? "desc" : "asc"), class: "text-decoration-none" %></th>
      <th>Total Rows</th>
      <th>Sidekiq Status</th>
      <th>Job Status</th>
      <th>Action</th>
    </tr>
  </thead>
  <tbody>
    <% @jobs.each do |job| %>
      <tr>
        <td><%= job.id %></td>
        <td><%= job.user.display_name %></td>
        <td><%= job.created_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
        <td><%= job.total_rows %></td>
        <td><%= job.respond_to?(:sidekiq_status) ? job.sidekiq_status : "-" %></td>
        <td><%= job.get_status %></td>
        <td>
          <%= link_to "View", admin_job_path(job), target: "_blank", class: "btn btn-xs btn-primary" %>
          <% if job.is_enqueued_or_scheduled_in_sidekiq? %>
            <%= link_to "Cancel", cancel_admin_job_path(job), class: "btn btn-xs btn-secondary" %>
          <% end %>
          <%= button_to "Delete",
                admin_job_path(job),
                method: :delete,
                form: { class: "d-inline" },
                data: { confirm: "Are you sure?" },
                class: "btn btn-xs btn-secondary" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= paginate @jobs %>