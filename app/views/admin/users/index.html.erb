<h4 class="mb-2">Create A New User</h4>
<div class="mb-4">
  <%= form_with url: admin_users_path, method: :post, local: true do |f| %>
   
   

    <div class="form-group mt-3">
      <%= f.label :display_name, "Name" %>
      <%= f.text_field :display_name, class: "form-control mt-2", placeholder: "Enter name" %>
    </div>
    <div class="form-group mt-3">
      <%= f.label :client_id, "Client ID (optional)" %>
      <%= f.text_field :client_id, class: "form-control mt-2", placeholder: "Enter client ID" %>
    </div>
    <div class="form-group mt-3">
      <%= f.label :email, "Email" %>
      <%= f.email_field :email, class: "form-control mt-2", placeholder: "Enter email" %>
    </div>
    <div class="mt-3">
      <%= f.submit "Create User", class: "btn btn-primary btn-sm" %>
    </div>
  <% end %>
</div>

<h4>Existing Users</h4>
<table class="table table-striped table-bordered">
  <thead>
    <tr>
      <th>ID</th>
      <th>Username</th>
      <th>Email</th>
      <th>Created At</th>
      <th>Action</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.id %></td>
        <td><%= user.display_name %></td>
        <td><%= user.email %></td>
        <td><%= user.created_at.strftime("%Y-%m-%d") %></td>
        <td>
          <%= link_to "Tokens", tokens_admin_user_path(user), class: "btn btn-xs btn-primary" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= paginate @users %>