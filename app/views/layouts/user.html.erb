<!DOCTYPE html>
<html>
  <head>
    <title>Batch BC Geocoder</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="turbo-cache-control" content="no-preview">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <style>
      /* Make sure body and html elements fill the full height of the screen */
      html, body {
        height: 100%;
      }
      /* Use flexbox to push the footer to the bottom */
      .content {
        min-height: 100%;
        display: flex;
        flex-direction: column;
      }
      footer {
        margin-top: auto; /* Push the footer to the bottom */
      }
    </style>
  </head>

  <body>
    <div class="content">
      <%= render partial: "layouts/main_navbar" %>
      <% if ServerStatus.paused? %>
        <p class="alert alert-primary">New submissions to the Batch Geocoder is currently paused.</p>
      <% end %>
      <% if notice || alert %>
        <div class="container mt-3">
          <% if notice %>
            <p class="alert alert-primary"><%= notice %></p>
          <% end %>
          <% if alert %>
            <p class="alert alert-secondary" style="color: red;"><%= alert %></p>
          <% end %>
        </div>
      <% end %>
      
      <div class="container mt-4">
        <%= yield %>
      </div>
      
      <footer class="bg-dark text-white text-center text-lg-start">
        <div class="text-center p-3 bg-secondary">
          © 2026 Government of British Columbia.
        </div>
      </footer>
    </div>
  </body>
</html>
