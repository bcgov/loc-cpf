<h1 class="mb-4">Tokens for <%= @user.idir_username %></h1>


<h4 class="mb-2">Create New Token 
<small class="text-muted">(max <%= Token::MAX_TOKENS_PER_USER %> tokens)</small></h4>
<div class="mb-4">
  <%= form_with url: tokens_admin_user_path(@user), method: :post, local: true do |f| %>
   
    <div class="form-group">
      <%= f.label :expired_at, "Expires On (optional)" %>
      <%= f.date_field :expired_at, class: "form-control mt-2", min: Date.current.iso8601 %>
    </div>

    <div class="form-group mt-3">
      <%= f.label :value, "Value (optional)" %>
      <%= f.text_field :value, class: "form-control mt-2", placeholder: "Enter token value" %>
    </div>
    <div class="mt-3">
      <%= f.submit "Create Token", class: "btn btn-primary btn-sm" %>
    </div>
  <% end %>
</div>

<h4 class="mb-2">Existing Tokens</h4>
<table class="table table-striped table-bordered">
  <thead>
    <tr>
      <th>Created At</th>
      <th>Token Value</th>
      
      <th>Expires At</th>
      <th>Action</th>
    </tr>
  </thead>
  <tbody>
    <% @tokens.each do |token| %>
      <tr>
        <td><%= token.created_at.strftime("%Y-%m-%d %I:%M %p") %></td>
        <td><code><%= token.value %></code></td>
        <td>
          <% if token.expired_at.present? %>
            <%= token.expired_at <= Time.current ? "Expired" : token.expired_at.strftime("%Y-%m-%d %I:%M %p") %>
          <% else %>
            Never
          <% end %>
        </td>
        <td>
          <%= button_to "Delete", revoke_token_admin_user_path(token), method: :delete, class: "btn btn-xs btn-outline-primary", data: { confirm: "Delete this token?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>